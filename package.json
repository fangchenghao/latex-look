{
  "name": "@fffangchenghao/dsh-latex-look",
  "version": "0.4.0",
  "description": "See what a LaTeX page actually looks like: compile, render the page to an image, map a point or text anchor back to the source line, and diff the page against the previous build. CLI, MCP server and DSH plugin over one core.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "latex-look": "bin/latex-look.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CASE-STUDY.md",
    "README.zh-CN.md",
    "docs/before-after.png",
    "examples/broken-layout/broken.tex",
    "examples/broken-layout/fixed.tex",
    "examples/broken-layout/README.md",
    "bin/latex-look.mjs",
    "bin/mcp.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/scenarios.mjs && node test/scenarios-deep.mjs && node test/mcp.mjs",
    "test:unit": "node test/smoke.mjs",
    "test:scenarios": "node test/scenarios.mjs",
    "test:deep": "node test/scenarios-deep.mjs",
    "test:book": "node test/book-scenarios.mjs",
    "test:mcp": "node test/mcp.mjs"
  },
  "keywords": [
    "agent",
    "claude",
    "dsh",
    "latex",
    "layout",
    "mcp",
    "model-context-protocol",
    "pdf",
    "plugin",
    "synctex",
    "vision"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangchenghao/latex-look.git"
  },
  "homepage": "https://github.com/fangchenghao/latex-look#readme",
  "bugs": {
    "url": "https://github.com/fangchenghao/latex-look/issues"
  },
  "author": "fangchenghao",
  "mcpName": "io.github.fangchenghao/latex-look"
}
