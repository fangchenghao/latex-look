{
  "name": "dsh-latex-look",
  "version": "0.2.0",
  "description": "DSH plugin: let an AI agent see a LaTeX document — compile it, render the page, locate the source line, and diff what an edit changed.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "latex-look": "bin/latex-look.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin/latex-look.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/scenarios.mjs && node test/scenarios-deep.mjs",
    "test:unit": "node test/smoke.mjs",
    "test:scenarios": "node test/scenarios.mjs",
    "test:deep": "node test/scenarios-deep.mjs",
    "test:book": "node test/book-scenarios.mjs"
  },
  "keywords": [
    "latex",
    "dsh",
    "plugin",
    "agent",
    "synctex",
    "vision",
    "pdf",
    "layout"
  ]
}
